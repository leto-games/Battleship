{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Отладка DLL через тестовый EXE",
            "type": "cppvsdbg", // Для MSVC на Windows. Используйте "cppdbg" для GCC/Clang (GDB/LLDB)
            "request": "launch",
            "program": "${env:LETO_PATH}/Console/win-st7735-debug/bin/leto-console.exe",
            "args": [
                "--user", "0",
                "--game", 
                "${env:LETO_PATH}/Apps/win-debug/${input:CMakeProjectName}/${input:CMakeProjectName}.dll"
            ],
            "stopAtEntry": false,
            "cwd": "${env:LETO_PATH}/Console/win-st7735-debug/bin/",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "(gdb) Linux debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:LETO_PATH}/Console/linux-st7735-debug/bin/leto-console",
            "args": [
                "--user", "0",
                "--game", 
                "${env:LETO_PATH}/Apps/linux-debug/${input:CMakeProjectName}/lib${input:CMakeProjectName}.so"
            ],
            "stopAtEntry": false,
            "cwd": "${env:LETO_PATH}/Console/linux-st7735-debug/bin/",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Pending breakpoints for dlopen'd game lib",
                    "text": "-gdb-set breakpoint pending on", 
                    "ignoreFailures": true 
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "CMakeProjectName",
            "type": "command",
            "command": "cmake.cacheVariable",
            "args": {
                "name": "CMAKE_PROJECT_NAME"
            }
        }
    ]
}