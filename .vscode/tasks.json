{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: Configure (Preset)",
            "command": "cmake",
            "args": [
                "--preset",
                "win-debug" // Замените "default" на имя вашего пресета из cmake-presets.json
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake: Build (Preset)", // Именно это имя нужно указать в preLaunchTask в launch.json
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "win-debug", // Замените "default" на имя вашего пресета для сборки
                "-j"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Configure (Preset)" // Сначала автоматически запустится конфигурация
            ]
            // "problemMatcher": [
            //     "$gcc" // Используйте "$msCompile" для MSVC или кликните для выбора своего
            // ]
        }
    ]
}